// DL7 CLEANING. The original Havus name and icon are excluded from the fork.
PRODUCT_NAME = DL7 CLEANING
PRODUCT_BUNDLE_IDENTIFIER = com.dahlah7.dl7cleaning.macos
PRODUCT_BUNDLE_IDENTIFIER[config=Debug] = com.dahlah7.dl7cleaning.macos.debug
MARKETING_VERSION = 0.4.2
CURRENT_PROJECT_VERSION = 6

SDKROOT = macosx
MACOSX_DEPLOYMENT_TARGET = 14.0
SWIFT_VERSION = 6.0
GENERATE_INFOPLIST_FILE = YES
INFOPLIST_KEY_CFBundleDisplayName = DL7 CLEANING
INFOPLIST_KEY_LSApplicationCategoryType = public.app-category.utilities
INFOPLIST_KEY_NSHumanReadableCopyright = © 2026 DL7 CLEANING. Based on Havus © 2026 Debi Kurnia (MIT).
ASSETCATALOG_COMPILER_APPICON_NAME = AppIcon
ASSETCATALOG_COMPILER_GLOBAL_ACCENT_COLOR_NAME = AccentColor
SWIFT_EMIT_LOC_STRINGS = YES
LOCALIZATION_PREFERS_STRING_CATALOGS = YES

// The Mac engine needs user-authorized access to other app caches.
ENABLE_APP_SANDBOX = NO
ENABLE_HARDENED_RUNTIME = YES
ENABLE_USER_SCRIPT_SANDBOXING = YES
DEAD_CODE_STRIPPING = YES
COMBINE_HIDPI_IMAGES = YES
CODE_SIGN_STYLE = Automatic
CODE_SIGN_IDENTITY = -
DEVELOPMENT_TEAM =
#include? "Local.xcconfig"
